# Selects config-dev.yml for local runs (see agent_lab.core.config.default_config_source)
DEVELOPING="True"

# --- v3 corpus teacher (dataset/pipelines/v3) -------------------------------
# Spec §9. Only needed to RENDER; packs, verify and prefer are pure CPU, and
# `exam` composes locally with no teacher at all.
#
# Live calls are opt-in and bill: nothing reaches the network unless
# COSIMO_V3_LIVE=1. Without it the renderer replays the offline fixture under
# dataset/tests/v3/fixtures/, which is what CI runs.

# The OpenAI-v1 root, WITHOUT the /v1 suffix. The client appends
# `/v1/chat/completions` itself, so a base ending in `/v1` posts to
# `/v1/v1/chat/completions` and the endpoint answers 404.
TEACHER_BASE_URL=http://localhost:8888

# Must be non-empty even for a local server that ignores auth: the live path
# refuses to start when it is unset, so an operator sees the missing name
# rather than a 401 from the far end.
TEACHER_API_KEY=local-no-auth

# Spec §5.4's "one client, two model names". Both must be names the endpoint
# actually serves -- check `GET $TEACHER_BASE_URL/v1/models`. The reasoning
# lane takes exam, implementation, agentic, critique and abstention; the prose
# lane takes analysis, memo and grounded. Pointing both at one model is a
# legitimate configuration; every row records which model answered
# (`verification.teacher.model`), and the publish gate refuses a corpus that
# mixes models unless COSIMO_V3_TEACHER_ALLOWLIST says the mix is deliberate.
TEACHER_REASONING=deepseek-v4-flash
TEACHER_PROSE=qwen3.8-flash-next
# Per-call timeout. 120 is far too short for a reasoning teacher at the 8192
# completion budget below: the chain of thought is billed against that budget
# before the first answer token, and a local box can take minutes. A live run
# that trips this aborts the whole render stage -- deliberately, since a
# transport outage is something to retry, not a reason to dead-letter good
# scenarios.
TEACHER_TIMEOUT_S=900

# Completion budget per call (COSIMO_V3_MAX_TOKENS overrides the built-in
# default). A reasoning model spends most of this thinking: deepseek-v4-flash
# used 4,851 tokens to produce a 109-word answer, and returned nothing at all
# at 1024 and at 4096. Lower it for a non-reasoning teacher. Changing it
# rekeys every replay fixture.
COSIMO_V3_MAX_TOKENS=8192

# Absolute root of the shard tree. Never CWD-relative (spec §12).
COSIMO_V3_OUT=dataset/shards/v3

# Set to 1 to allow billed teacher calls. Unset = offline fixture replay.
# COSIMO_V3_LIVE=1
