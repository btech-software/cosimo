# Generated by the pipeline. Reproducible from the templates, config/seed.json and
# the deterministic per-(program, template, variant) seeds, so none of it belongs
# in git.

# pipelines/generate.py output
shards/

# pipelines/progress.py output, rewritten on every generation run
progress/

# scripts/publish_dataset.py default output name
dataset_v2_*.json

# in-flight shard writes, before _finalize_all() renames them
*.jsonl.tmp

# eval/ab_eval.py working files. ab_results.json is a per-round measurement -- if
# you want to keep a round's numbers, copy it to a round-stamped name and track that.
eval/ab_tasks.jsonl
eval/ab_scores.jsonl
eval/ab_results.json

# verification/suite_overlap.py report, regenerated on every run
verification/suite_overlap.json

# smoke-run scratch output
.smoke/

__pycache__/

# Deliberately tracked, despite being generated:
#   taxonomy/coverage.json  - the brief requires coverage tracked as data, not prose
#   goldbar/gold_bar.jsonl  - a measurement instrument; must be diffable and reviewable
